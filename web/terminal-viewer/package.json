{
  "name": "reader-terminal-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "notices": "node scripts/generate-notices.mjs",
    "manifest": "node scripts/generate-manifest.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run notices && npm run manifest"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "jsdom": "24.1.3",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}